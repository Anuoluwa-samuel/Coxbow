# Copy to .env.local and fill in. Never commit real secrets.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Coxbow
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=          # digits only, e.g. 2348012345678
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_HOURS=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_X=

# --- Database (server only) ---
# Local: docker compose up -d db
DATABASE_URL=postgres://coxbow:coxbow_local_dev@localhost:54329/coxbow
DATABASE_URL_TEST=postgres://coxbow:coxbow_local_dev@localhost:54329/coxbow_test

# --- Seeding (demonstration data and first admin) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=                   # min 12 characters

# --- Paystack (server only) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# --- Notifications (server only) ---
EMAIL_PROVIDER=console                 # console | resend
RESEND_API_KEY=
EMAIL_FROM=

# --- App secret (server only): signs booking access tokens and hashes IPs. >= 32 chars.
APP_SECRET=
